#!/usr/bin/env bash
set -euo pipefail

# ---- Config ----
SKOLL_HOME="${HOME}/.skoll"
SKOLL_STOWED="${SKOLL_HOME}/stowed"
SKOLL_INI="${SKOLL_HOME}/skoll.ini"

# ---- Helpers ----

# Read a key from skoll.ini
read_config() {
  local key="$1"
  local default="${2:-}"
  if [ -f "$SKOLL_INI" ]; then
    local val
    val=$(grep "^${key}=" "$SKOLL_INI" | cut -d= -f2- | head -1)
    if [ -n "$val" ]; then
      echo "$val"
      return
    fi
  fi
  echo "$default"
}

# Resolve local skills directory in the current directory only (no parent walk).
resolve_local_skills_dir_cwd_only() {
  local dir_name
  dir_name=$(read_config "local_skills_dir" ".agents/skills/")
  # Normalize: strip trailing slash
  dir_name="${dir_name%/}"

  local cwd
  cwd="$(pwd)"

  echo "$cwd/$dir_name"
}

# Walk up from cwd looking for the local skills directory.
# Tries the primary local_skills_dir first, then the fallback if set.
resolve_local_skills_dir() {
  local dir_name
  dir_name=$(read_config "local_skills_dir" ".agents/skills/")
  # Normalize: strip trailing slash
  dir_name="${dir_name%/}"

  local cwd
  cwd="$(pwd)"

  # Try walking up with primary dir name
  local check="$cwd"
  while true; do
    if [ -d "$check/$dir_name" ]; then
      echo "$check/$dir_name"
      return
    fi
    if [ "$check" = "/" ]; then
      break
    fi
    check="$(dirname "$check")"
  done

  # Try fallback if configured
  local fallback
  fallback=$(read_config "fallback" "")
  if [ -n "$fallback" ]; then
    # Expand ~ if present
    fallback="${fallback/#\~/$HOME}"
    if [ -d "$fallback" ]; then
      echo "$fallback"
      return
    fi
  fi

  # Not found anywhere, use current directory
  echo "$cwd/$dir_name"
}

# Walk up from cwd looking for ALL local skills directories.
# Returns each found directory on its own line, plus the fallback if set.
resolve_all_local_skills_dirs() {
  local dir_name
  dir_name=$(read_config "local_skills_dir" ".agents/skills/")
  dir_name="${dir_name%/}"

  local cwd
  cwd="$(pwd)"

  # Collect all directories found while walking up
  local dirs=()
  local check="$cwd"
  while true; do
    if [ -d "$check/$dir_name" ]; then
      dirs+=("$check/$dir_name")
    fi
    if [ "$check" = "/" ]; then
      break
    fi
    check="$(dirname "$check")"
  done

  # Also check fallback if configured
  local fallback
  fallback=$(read_config "fallback" "")
  if [ -n "$fallback" ]; then
    fallback="${fallback/#\~/$HOME}"
    if [ -d "$fallback" ]; then
      # Only add if not already in the list
      local found=0
      for d in "${dirs[@]}"; do
        if [ "$d" = "$fallback" ]; then
          found=1
          break
        fi
      done
      if [ "$found" -eq 0 ]; then
        dirs+=("$fallback")
      fi
    fi
  fi

  # Output all directories
  for d in "${dirs[@]}"; do
    echo "$d"
  done
}

# Format a directory path for display:
# - Replace $HOME with ~
# - If under cwd, use relative path with ./ prefix
# - Append trailing slash if not present
format_skills_dir() {
  local dir="$1"
  local cwd
  cwd="$(pwd)"

  # Use relative path if under cwd
  if [[ "$dir" == "$cwd"/* ]]; then
    dir="./${dir#$cwd/}"
  elif [ "$dir" = "$cwd" ]; then
    dir="."
  fi

  # Replace HOME with ~
  dir="${dir/#$HOME/\~}"

  # Append trailing slash if not present
  if [[ "$dir" != */ ]]; then
    dir="${dir}/"
  fi

  echo "$dir"
}

# Validate that command arguments don't contain unrecognized flags
_validate_no_flags() {
  local cmd_name="$1"
  shift
  for arg in "$@"; do
    if [[ "$arg" == -* ]]; then
      echo "skoll: unrecognized option '$arg' for '$cmd_name'" >&2
      echo "Run 'skoll --help' for usage." >&2
      exit 1
    fi
  done
}

# ---- Commands ----

cmd_list() {
  local stowed="${1:-}"

  if [ -n "$stowed" ] && [ "$stowed" != "--stowed" ]; then
    echo "skoll: unrecognized option '$stowed' for 'list'" >&2
    echo "Usage: skoll list [--stowed]" >&2
    exit 1
  fi

  if [ "$stowed" = "--stowed" ]; then
    cmd_list_stowed
    return
  fi

  local dirs
  dirs=$(resolve_all_local_skills_dirs)
  if [ -z "$dirs" ]; then
    return
  fi

  local first_dir=1
  local dir
  while IFS= read -r dir; do
    [ -d "$dir" ] || continue

    local found=0
    local skills=()
    local entry
    for entry in "$dir"/*; do
      [ -L "$entry" ] || continue
      local name
      name="$(basename "$entry")"
      if [ -e "$entry" ]; then
        skills+=("$name")
      else
        skills+=("$name [broken]")
      fi
      found=1
    done

    if [ "$found" -eq 0 ]; then
      continue
    fi

    if [ "$first_dir" -eq 0 ]; then
      echo ""
    fi
    first_dir=0

    local formatted_dir
    formatted_dir=$(format_skills_dir "$dir")
    echo "$formatted_dir"

    for skill in "${skills[@]}"; do
      echo "    $skill"
    done
  done <<< "$dirs"
}

# Collect stowed skill metadata as pipe-separated lines: name|subfolder|source
# Internal helper used by cmd_list_stowed, cmd_search, and cmd_add_interactive.
_collect_stowed_entries() {
  if [ ! -d "$SKOLL_STOWED" ]; then
    return
  fi

  local skill_file
  while IFS= read -r -d '' skill_file; do
    # Relative path from stowed to SKILL.md, e.g. "my-skill/SKILL.md" or "repo/subdir/skill/SKILL.md"
    local rel="${skill_file#$SKOLL_STOWED/}"
    IFS='/' read -ra parts <<< "$rel"
    local num_parts=${#parts[@]}

    # parts[-2] = skill name (parent dir of SKILL.md)
    local skill_name="${parts[$((num_parts-2))]}"

    # Compute the parent path prefix (everything before the skill dir)
    local parent_path_parts=()
    local i
    for ((i=0; i<num_parts-2; i++)); do
      parent_path_parts+=("${parts[$i]}")
    done
    local num_parent=${#parent_path_parts[@]}

    # Determine source and subfolder
    local source="local"
    local subfolder="_none_"

    # Walk up parent parts to find a git submodule boundary
    # A git submodule has a .git FILE (not directory) with gitdir: pointer
    local found_submodule=0
    local acc=""
    for ((i=0; i<num_parent; i++)); do
      if [ -z "$acc" ]; then
        acc="${parent_path_parts[$i]}"
      else
        acc="$acc/${parent_path_parts[$i]}"
      fi

      if [ -f "$SKOLL_STOWED/$acc/.git" ] && [ ! -d "$SKOLL_STOWED/$acc/.git" ]; then
        # Found a submodule: source is the submodule path
        source="$acc"
        found_submodule=1

        # Subfolder is everything between the submodule and the skill dir
        local remaining_parts=()
        local j
        for ((j=i+1; j<num_parent; j++)); do
          remaining_parts+=("${parent_path_parts[$j]}")
        done

        if [ "${#remaining_parts[@]}" -eq 0 ]; then
          subfolder="_none_"
        else
          subfolder=""
          for ((j=0; j<${#remaining_parts[@]}; j++)); do
            if [ -z "$subfolder" ]; then
              subfolder="${remaining_parts[$j]}"
            else
              subfolder="$subfolder/${remaining_parts[$j]}"
            fi
          done
        fi
        break
      fi
    done

    if [ "$found_submodule" -eq 0 ]; then
      # Not in a submodule
      source="local"
      if [ "$num_parent" -eq 0 ]; then
        subfolder="_none_"
      elif [ "$num_parent" -eq 1 ]; then
        # stowed/category/skill-name/ — category is the subfolder
        subfolder="${parent_path_parts[0]}"
      else
        # multi-level path without submodule
        subfolder=""
        for ((i=0; i<num_parent; i++)); do
          if [ -z "$subfolder" ]; then
            subfolder="${parent_path_parts[$i]}"
          else
            subfolder="$subfolder/${parent_path_parts[$i]}"
          fi
        done
      fi
    fi

    echo "$skill_name|$subfolder|$source"

  done < <(find "$SKOLL_STOWED" -mindepth 2 -type f -name "SKILL.md" -print0 2>/dev/null)
}

# Build a formatted table from pipe-separated entries (name|subfolder|source)
# Includes header + separator row. Output written to stdout.
_format_stowed_table() {
  local rows="$1"

  if [ -z "$rows" ]; then
    return
  fi

  # Compute dynamic column widths (min 4 for header words)
  local max_name=4
  local max_source=6
  local max_sub=9

  local IFS=$'\n'
  for row in $rows; do
    local name="${row%%|*}"
    local rest="${row#*|}"
    local subfolder="${rest%%|*}"
    local source="${rest#*|}"

    [ "${#name}" -gt "$max_name" ] && max_name="${#name}"
    [ "${#source}" -gt "$max_source" ] && max_source="${#source}"
    [ "${#subfolder}" -gt "$max_sub" ] && max_sub="${#subfolder}"
  done

  # Add 1-char breathing room on name and source columns
  local pad_name=$((max_name + 1))
  local pad_source=$((max_source + 1))

  # Print header + separator (order: name | source | subfolder)
  printf "%-${pad_name}s | %-${pad_source}s | %s\n" "name" "source" "subfolder"
  printf "%-${pad_name}s | %-${pad_source}s | %s\n" "---" "---" "---"

  # Print data rows
  for row in $rows; do
    local name="${row%%|*}"
    local rest="${row#*|}"
    local subfolder="${rest%%|*}"
    local source="${rest#*|}"
    printf "%-${pad_name}s | %-${pad_source}s | %s\n" "$name" "$source" "$subfolder"
  done
}

cmd_list_stowed() {
  local rows
  rows=$(_collect_stowed_entries)
  _format_stowed_table "$rows"
}

# Format a pipe-separated entry (name|subfolder|source) for fzf/search display
# Outputs "skill-name (parent-path)"
cmd_get() {
  _validate_no_flags "get" "$@"
  local url="$1"

  # Derive path from URL:
  #   SSH:   git@github.com:mattpocock/skills.git  →  mattpocock/skills
  #   HTTPS: https://github.com/mattpocock/skills.git  →  mattpocock/skills
  #   Local: /path/to/skills  →  skills
  local path_spec
  if [[ "$url" == *"://"* ]] && [[ "$url" != "file://"* ]]; then
    # Remote HTTPS URL: strip protocol + hostname, keep owner/repo
    local after_protocol="${url#*://}"
    path_spec="${after_protocol#*/}"
  elif [[ "$url" == *"@"*":"* ]] && [[ "$url" != "/"* ]]; then
    # SSH URL: extract after colon  →  owner/repo.git
    path_spec="${url#*:}"
  else
    # Local path or file://: use just the basename
    path_spec="$(basename "$url")"
  fi

  # Strip .git suffix
  path_spec="${path_spec%.git}"

  # Create parent directory (e.g. stowed/mattpocock/) if needed
  local parent_dir
  parent_dir="$(dirname "$path_spec")"
  if [ "$parent_dir" != "." ]; then
    mkdir -p "$SKOLL_STOWED/$parent_dir"
  fi

  # Check for collision
  if [ -d "$SKOLL_STOWED/$path_spec" ]; then
    echo "error: '$path_spec' already exists in stowed directory" >&2
    exit 1
  fi

  if [ ! -d "$SKOLL_STOWED/.git" ]; then
    echo "error: stowed directory is not a git repository. Re-run install.sh (without --no-git)" >&2
    exit 1
  fi

  # Add as submodule
  git -C "$SKOLL_STOWED" submodule add "$url" "$path_spec"
  echo "added '$path_spec' to stowed directory"
}

cmd_update() {
  _validate_no_flags "update" "$@"
  if [ ! -d "$SKOLL_STOWED/.git" ]; then
    echo "error: stowed directory is not a git repository. Re-run install.sh (without --no-git)" >&2
    exit 1
  fi

  echo "pulling latest changes for stowed repository..."
  git -C "$SKOLL_STOWED" pull 2>/dev/null || echo "  (no upstream configured, skipping)"
  echo "updating submodules..."
  git -C "$SKOLL_STOWED" submodule update --remote
  echo "update complete."
}

cmd_rm_stowed() {
  local repo_name="$1"

  if [ ! -d "$SKOLL_STOWED/$repo_name" ]; then
    echo "error: '$repo_name' not found in stowed directory" >&2
    exit 1
  fi

  # Check if any local skills reference this repo
  local local_dir
  local_dir="$(resolve_local_skills_dir)"

  if [ -d "$local_dir" ]; then
    local in_use=0
    local entry
    for entry in "$local_dir"/*; do
      [ -L "$entry" ] || continue
      local target
      target="$(readlink "$entry")"
      if [[ "$target" == "$SKOLL_STOWED/$repo_name"* ]]; then
        local skill_name
        skill_name="$(basename "$entry")"
        echo "warning: '$skill_name' from '$repo_name' is still in use in $local_dir" >&2
        in_use=1
      fi
    done
  fi

  # Full submodule removal
  if [ -d "$SKOLL_STOWED/.git" ]; then
    git -C "$SKOLL_STOWED" submodule deinit -f "$repo_name" 2>/dev/null || true
    git -C "$SKOLL_STOWED" rm -f "$repo_name"
    rm -rf "$SKOLL_STOWED/.git/modules/$repo_name"
  else
    # Not a git repo, just remove the directory
    rm -rf "$SKOLL_STOWED/$repo_name"
  fi

  # Clean up owner parent dir if now empty
  local parent_dir
  parent_dir="$(dirname "$repo_name")"
  if [ "$parent_dir" != "." ] && [ -d "$SKOLL_STOWED/$parent_dir" ]; then
    rmdir "$SKOLL_STOWED/$parent_dir" 2>/dev/null || true
  fi

  echo "removed '$repo_name' from stowed directory"
}

cmd_search() {
  local pattern="${1:-}"

  # Gather all skills entry data
  local all_entries
  all_entries=$(_collect_stowed_entries)

  if [ -z "$all_entries" ]; then
    return
  fi

  # Same table format as what add -i shows in fzf: data rows (no header/separator),
  # aligned columns: name, subfolder, source
  local formatted
  formatted=$(_format_stowed_table "$all_entries" | tail -n +3)

  if [ -z "$pattern" ]; then
    # Interactive: pipe to fzf
    echo "$formatted" | fzf
  else
    # Non-interactive: pipe to fzf --filter
    echo "$formatted" | fzf --filter "$pattern"
  fi
}

# ---- Helpers for add ----

# Find a stowed skill by name. Returns the full path if exactly one match,
# or empty string if none, or "AMBIGUOUS" if multiple repos have the same skill name.
find_stowed_skill() {
  local skill_name="$1"
  local found=""
  local count=0

  while IFS= read -r -d '' skill_file; do
    local dir
    dir="$(dirname "$skill_file")"
    local name
    name="$(basename "$dir")"
    if [ "$name" = "$skill_name" ]; then
      count=$((count + 1))
      found="$dir"
    fi
  done < <(find "$SKOLL_STOWED" -type f -name "SKILL.md" -print0 2>/dev/null)

  if [ "$count" -eq 0 ]; then
    echo ""
  elif [ "$count" -eq 1 ]; then
    echo "$found"
  else
    echo "AMBIGUOUS"
  fi
}

# ---- Commands: add interactive ----

cmd_add_interactive() {
  # Gather all stowed skills entry data
  local all_entries
  all_entries=$(_collect_stowed_entries)

  if [ -z "$all_entries" ]; then
    echo "error: no stowed skills to add" >&2
    exit 1
  fi

  # Build the same table format as list --stowed, but strip header/separator
  # so fzf only shows data rows (aligned columns, no selectable header cruft)
  local table
  table=$(_format_stowed_table "$all_entries" | tail -n +3)

  local selected
  selected=$(echo "$table" | fzf -m)

  if [ -z "$selected" ]; then
    # User cancelled
    exit 0
  fi

  # Extract skill names from selected table rows: take the first column
  local args=()
  while IFS= read -r line; do
    local skill
    skill=$(echo "$line" | sed 's/ *|.*//')
    args+=("$skill")
  done <<< "$selected"

  cmd_add "${args[@]}"
}

# ---- Commands: add ----

cmd_add() {
  # Validate that flags are recognized
  for arg in "$@"; do
    if [[ "$arg" == -* ]] && [ "$arg" != "--ALL" ] && [ "$arg" != "--interactive" ] && [ "$arg" != "-i" ]; then
      echo "skoll: unrecognized option '$arg' for 'add'" >&2
      echo "Run 'skoll --help' for usage." >&2
      exit 1
    fi
  done

  if [ "${1:-}" = "--ALL" ]; then
    cmd_add_all
    return
  fi

  if [ $# -lt 1 ]; then
    echo "usage: skoll add <skill> [<skill>...]" >&2
    echo "       skoll add --ALL" >&2
    echo "       skoll add --interactive" >&2
    exit 1
  fi

  local skills=("$@")

  # Resolve local skills directory (cwd only, no parent walk)
  local local_dir
  local_dir="$(resolve_local_skills_dir_cwd_only)"

  # If local skills directory doesn't exist, ask to create it
  if [ ! -d "$local_dir" ]; then
    echo "Local skills directory '$local_dir' does not exist." >&2
    echo -n "Create it? [y/N] " >&2
    read -r confirm
    if [ "$confirm" != "y" ] && [ "$confirm" != "Y" ]; then
      echo "Aborted." >&2
      exit 1
    fi
    mkdir -p "$local_dir"
  fi

  # Phase 1: validate all preconditions before making any changes
  local sources=()
  for skill in "${skills[@]}"; do
    # Find the skill in stowed directory
    local found
    found=$(find_stowed_skill "$skill")
    if [ -z "$found" ]; then
      echo "error: skill '$skill' not found in stowed directory" >&2
      exit 1
    fi
    if [ "$found" = "AMBIGUOUS" ]; then
      echo "error: skill '$skill' exists in multiple repos; use the full path to disambiguate" >&2
      exit 1
    fi
    sources+=("$found")

    # Check target path
    local target="$local_dir/$skill"
    if [ -e "$target" ]; then
      if [ ! -L "$target" ]; then
        echo "error: '$target' exists and is not a symlink" >&2
        exit 1
      fi
      # It's a symlink; check if it's broken or valid
      if [ -e "$target" ]; then
        echo "error: skill '$skill' already exists in local directory" >&2
        exit 1
      fi
      # Broken symlink — will be replaced
    fi
  done

  # Phase 2: create symlinks
  local i=0
  for skill in "${skills[@]}"; do
    local src="${sources[$i]}"
    local target="$local_dir/$skill"

    # Remove broken symlink if present
    if [ -L "$target" ] && [ ! -e "$target" ]; then
      rm "$target"
    fi

    ln -s "$src" "$target"
    echo "added '$skill'"
    i=$((i + 1))
  done
}

cmd_add_all() {
  if [ ! -d "$SKOLL_STOWED" ]; then
    echo "error: no stowed skills to add" >&2
    exit 1
  fi

  # Gather all stowed skill paths
  local skill_paths=()
  local skill_names=()
  while IFS= read -r -d '' skill_file; do
    local dir
    dir="$(dirname "$skill_file")"
    local name
    name="$(basename "$dir")"
    skill_paths+=("$dir")
    skill_names+=("$name")
  done < <(find "$SKOLL_STOWED" -type f -name "SKILL.md" -print0 2>/dev/null)

  if [ "${#skill_names[@]}" -eq 0 ]; then
    echo "error: no stowed skills to add" >&2
    exit 1
  fi

  # Resolve local skills directory (cwd only, no parent walk)
  local local_dir
  local_dir="$(resolve_local_skills_dir_cwd_only)"

  # If local skills directory doesn't exist, ask to create it
  if [ ! -d "$local_dir" ]; then
    echo "Local skills directory '$local_dir' does not exist." >&2
    echo -n "Create it? [y/N] " >&2
    read -r confirm
    if [ "$confirm" != "y" ] && [ "$confirm" != "Y" ]; then
      echo "Aborted." >&2
      exit 1
    fi
    mkdir -p "$local_dir"
  fi

  # Phase 1: validate preconditions
  local i=0
  for skill in "${skill_names[@]}"; do
    local target="$local_dir/$skill"
    if [ -e "$target" ]; then
      if [ ! -L "$target" ]; then
        echo "error: '$target' exists and is not a symlink" >&2
        exit 1
      fi
      if [ -e "$target" ]; then
        echo "error: skill '$skill' already exists in local directory" >&2
        exit 1
      fi
      # Broken symlink — will be replaced
    fi
    i=$((i + 1))
  done

  # Phase 2: create symlinks
  i=0
  for skill in "${skill_names[@]}"; do
    local src="${skill_paths[$i]}"
    local target="$local_dir/$skill"

    # Remove broken symlink if present
    if [ -L "$target" ] && [ ! -e "$target" ]; then
      rm "$target"
    fi

    ln -s "$src" "$target"
    echo "added '$skill'"
    i=$((i + 1))
  done
}

# ---- Commands: rm (local) ----

cmd_rm() {
  _validate_no_flags "rm" "$@"
  if [ $# -lt 1 ]; then
    echo "usage: skoll rm <skill> [<skill>...]" >&2
    exit 1
  fi

  local local_dir
  local_dir="$(resolve_local_skills_dir_cwd_only)"

  if [ ! -d "$local_dir" ]; then
    echo "error: no local skills directory found" >&2
    exit 1
  fi

  local any_failed=0
  for skill in "$@"; do
    local target="$local_dir/$skill"

    if [ ! -e "$target" ] && [ ! -L "$target" ]; then
      echo "error: skill '$skill' not found in local directory" >&2
      any_failed=1
      continue
    fi

    if [ ! -L "$target" ]; then
      echo "warning: '$skill' is not managed by skoll; skipping" >&2
      continue
    fi

    # Resolve the symlink target to check if managed by skoll
    local link_target
    link_target="$(readlink "$target")"

    if [[ "$link_target" != "$SKOLL_STOWED"* ]]; then
      echo "warning: '$skill' is not managed by skoll; skipping" >&2
      continue
    fi

    rm "$target"
    echo "removed '$skill'"
  done

  if [ "$any_failed" -eq 1 ]; then
    exit 1
  fi
}

# ---- Commands: clean ----

cmd_clean() {
  local first="${1:-}"
  if [ -n "$first" ] && [ "$first" != "-f" ]; then
    echo "skoll: unrecognized option '$first' for 'clean'" >&2
    echo "Usage: skoll clean [-f]" >&2
    exit 1
  fi
  local force="${1:-}"

  local local_dir
  local_dir="$(resolve_local_skills_dir_cwd_only)"

  if [ ! -d "$local_dir" ]; then
    return
  fi

  # Gather managed symlinks (those pointing into stowed, including broken)
  local managed=()
  local entry
  for entry in "$local_dir"/*; do
    [ -L "$entry" ] || continue
    local link_target
    link_target="$(readlink "$entry")"
    if [[ "$link_target" == "$SKOLL_STOWED"* ]]; then
      managed+=("$entry")
    fi
  done

  if [ "${#managed[@]}" -eq 0 ]; then
    return
  fi

  if [ "$force" = "-f" ]; then
    for entry in "${managed[@]}"; do
      local name
      name="$(basename "$entry")"
      rm "$entry"
      echo "removed '$name'"
    done
  else
    echo "The following managed skills would be removed:"
    for entry in "${managed[@]}"; do
      local name
      name="$(basename "$entry")"
      echo "  $name"
    done
    echo "run 'skoll clean -f' to perform the removal"
  fi
}

# ---- Command: help ----

cmd_help() {
  cat <<'HELP'
skoll — local skill manager powered by git, stow and fzf

SYNOPSIS:
    skoll [--help|-h]
    skoll <command> [<args>]

COMMANDS:
    list                    List locally installed skills, grouped by directory
    list --stowed           List all skills managed by skoll in stowed dir

    search [<pattern>]      Fuzzy-search stowed skills with fzf; without
                            a pattern opens the interactive fzf picker

    add <skill> [...]       Symlink one or more stowed skills to the local
                            skills directory in the current directory
    add --ALL               Symlink all stowed skills into the local dir
                            in the current directory
    add --interactive, -i   Interactive multi-select from stowed skills via fzf,
                            then add the selected skills

    rm <skill> [...]        Remove one or more locally installed skills
                            from the current directory's local skills
                            directory (only those managed by skoll)
    rm --stowed <repo>      Remove a stowed skill repository entirely

    clean                   List managed skills that would be removed
                            (dry run; use -f to perform removal)
    clean -f                Remove all locally managed skills

    get <url>               Download a skill repository and add it to the
                            stowed directory (as a git submodule)

    update                  Git-pull all stowed skill submodules

    -h, --help              Show this help message

See README.md or the skoll data model for more details.
HELP
}

# ---- Main ----

main() {
  local cmd="${1:-}"
  shift 2>/dev/null || true

  case "$cmd" in
    list)
      cmd_list "${1:-}"
      ;;
    get)
      if [ $# -lt 1 ]; then
        echo "usage: skoll get <url>" >&2
        exit 1
      fi
      cmd_get "$1"
      ;;
    update)
      if [ $# -gt 0 ]; then
        cmd_update "$@"
      else
        cmd_update
      fi
      ;;
    rm)
      if [ "${1:-}" = "--stowed" ]; then
        if [ $# -lt 2 ]; then
          echo "usage: skoll rm --stowed <repo>" >&2
          exit 1
        fi
        cmd_rm_stowed "$2"
      else
        cmd_rm "$@"
      fi
      ;;
    clean)
      cmd_clean "${1:-}"
      ;;
    search)
      cmd_search "$@"
      ;;
    add)
      if [ "${1:-}" = "--interactive" ] || [ "${1:-}" = "-i" ]; then
        cmd_add_interactive
      else
        cmd_add "$@"
      fi
      ;;
    "-h"|"--help")
      cmd_help
      ;;
    "")
      cmd_help
      ;;
    *)
      echo "skoll: unknown command '$cmd'" >&2
      echo "Run 'skoll --help' for usage." >&2
      exit 1
      ;;
  esac
}

main "$@"
